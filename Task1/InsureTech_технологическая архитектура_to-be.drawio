        <mxCell id="cdn_i" parent="1" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="34" width="34" x="153" y="536" as="geometry" />
        </mxCell>
        <mxCell id="ddos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;arcSize=10;verticalAlign=top;align=center;spacingLeft=8;spacingRight=8;spacingTop=40;fontSize=11;fontColor=#1a1a1a;" value="&lt;b&gt;DDoS Protection&lt;/b&gt;&lt;br&gt;Фильтр всего&lt;br&gt;публичного трафика&lt;br&gt;перед балансировщиком." vertex="1">
          <mxGeometry height="130" width="210" x="310" y="530" as="geometry" />
        </mxCell>
        <mxCell id="ddos_i" parent="1" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="34" width="34" x="398" y="536" as="geometry" />
        </mxCell>
        <mxCell id="apigw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;arcSize=10;verticalAlign=top;align=center;spacingLeft=8;spacingRight=8;spacingTop=40;fontSize=11;fontColor=#1a1a1a;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;Квота партнёра — 20 RPS.&lt;br&gt;Сверх квоты ответ 429.&lt;br&gt;Сайт из-за партнёра&lt;br&gt;не деградирует." vertex="1">
          <mxGeometry height="130" width="200" x="600" y="530" as="geometry" />
        </mxCell>
        <mxCell id="apigw_i" parent="1" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="34" width="34" x="683" y="536" as="geometry" />
        </mxCell>
        <mxCell id="alb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;arcSize=10;verticalAlign=top;align=center;spacingLeft=8;spacingRight=8;spacingTop=40;fontSize=11;fontColor=#1a1a1a;" value="&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;br&gt;L7, target group на каждую зону.&lt;br&gt;Active health check: GET /ready.&lt;br&gt;Failover: active-active.&lt;br&gt;Мёртвая зона выпадает сама." vertex="1">
          <mxGeometry height="130" width="210" x="876" y="530" as="geometry" />
        </mxCell>
        <mxCell id="alb_i" parent="1" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="34" width="34" x="964" y="536" as="geometry" />
        </mxCell>
        <mxCell id="hc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=11;fontColor=#1a1a1a;" value="Health checks — все активные проверки:&lt;br&gt;1. CDN → Object Storage: origin health check.&lt;br&gt;2. ALB → Ingress каждой зоны: HTTP GET /ready, интервал 2 с, порог 2. Зона без&lt;br&gt;ответа выводится из ротации.&lt;br&gt;3. kubelet → POD: liveness GET /health (перезапуск), readiness GET /ready (под&lt;br&gt;уходит из Service).&lt;br&gt;4. Managed PostgreSQL: проверка хостов. Упавший primary заменяется репликой, FQDN переключается на неё." vertex="1">
          <mxGeometry height="130" width="440" x="1100" y="530" as="geometry" />
        </mxCell>
        <mxCell id="cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9ff;strokeColor=#5282ff;strokeWidth=2;arcSize=3;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1a1a1a;labelBackgroundColor=none;" value="Yandex Cloud    ·    folder insuretech-prod    ·    регион ru-central1    ·    VPC" vertex="1">
          <mxGeometry height="940" width="1520" x="40" y="760" as="geometry" />
        </mxCell>
        <mxCell id="k8s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;arcSize=8;verticalAlign=middle;align=left;spacingLeft=64;spacingRight=10;fontSize=13;fontColor=#1a1a1a;" value="Managed Kubernetes — один региональный кластер: 3 master, по одному в ru-central1-a / b / d.&lt;div&gt;Кворум etcd сохраняется при потере любой одной зоны. В каждой зоне свой node group.&lt;/div&gt;&lt;div&gt;Реплики подов равномерно распределены по зонам и не размещаются на одном узле.&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="1470" x="60" y="804" as="geometry" />
        </mxCell>
        <mxCell id="k8s_i" parent="1" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=data:image/svg+xml," value="" vertex="1">
