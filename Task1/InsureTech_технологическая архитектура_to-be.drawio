        <mxCell id="cdn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;arcSize=10;verticalAlign=top;align=center;spacingLeft=8;spacingRight=8;spacingTop=40;fontSize=11;fontColor=#1a1a1a;" value="&lt;b&gt;CDN&lt;/b&gt;&lt;br&gt;Точки присутствия в городах РФ.&lt;br&gt;Кэш статики и каталога&lt;br&gt;(продукты и тарифы)." vertex="1">
