        <mxCell id="ng_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;arcSize=10;verticalAlign=middle;align=left;spacingLeft=48;fontSize=12;fontColor=#1a1a1a;" value="Node group ru-central1-a&#xa;worker-узлы этой зоны" vertex="1">
